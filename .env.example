SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres
SUPABASE_SCHEMA=public
SUPABASE_STORAGE_BUCKET=kerma-uploads
SUPABASE_UPLOADS_METADATA_TABLE=kerma_uploads_files
SESSION_SECRET=replace-with-a-long-random-secret
AUTH_COOKIE_NAME=kerma_session
API_RATE_REDIS_URL=
ALLOWED_ORIGINS=

# Mongo runtime disabled for normal app requests.
# Leave MONGODB_URI and MONGO_* unset unless running legacy maintenance scripts.
